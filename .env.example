# Server Settings
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google GenAI API Key (Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL Database (AsyncPG Engine)
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/society_os_db

# Redis Cache & Mutex Store
REDIS_URL=redis://localhost:6379/0
